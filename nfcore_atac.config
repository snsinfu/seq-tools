includeConfig 'genome_catalog.config'
includeConfig 'macs3_atac.config'

profiles {
    with_control {
        params {
            with_control = true
        }
    }

    se_narrow {
        params {
            narrow_peak       = true
            macs_force_single = true
            fragment_size     = 75
            macs_fdr          = 0.05
            macs_maxgap       = 100
        }
    }

    se_broad {
        params {
            narrow_peak       = false
            macs_force_single = true
            fragment_size     = 75
            broad_cutoff      = 0.10
            macs_minlength    = 400
            macs_maxgap       = 50
        }
    }

    pe_narrow {
        params {
            narrow_peak     = true
            shift_reads     = true
            maxFragmentSize = 120
            macs_fdr        = 0.05
            macs_maxgap     = 100
        }
    }

    pe_broad {
        params {
            narrow_peak     = false
            shift_reads     = true
            maxFragmentSize = 250
            broad_cutoff    = 0.10
            macs_minlength  = 400
            macs_maxgap     = 50  // 4x = 200bp for broad peaks
        }
    }

    cheap {
        params {
            skip_picard_metrics   = true
            skip_preseq           = true
            skip_plot_profile     = true
            skip_plot_fingerprint = true
            skip_ataqv            = true
            skip_peak_qc          = true
            skip_peak_annotation  = true
            skip_consensus_peaks  = true
            skip_igv              = true
        }
    }
}
