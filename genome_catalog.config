/*
 * Reference catalog for locally managed genome assemblies.
 */
params.genomes = {
    def root     = "${launchDir}/Genome"
    def children = new File(root).listFiles()?.toList() ?: []
    return children
        .findAll { it.isDirectory() && new File(it, 'genome.fa').isFile() }
        .sort { it.name }
        .collectEntries { dir ->
            def name         = dir.name
            def base         = "${root}/${name}"
            def metaFile     = new File(dir, 'metadata.json')
            def bwaDir       = new File(dir, 'bwa_index')
            def bowtie2Dir   = new File(dir, 'bowtie2_index')
            def chromapDir   = new File(dir, 'chromap_index')
            def starDir      = new File(dir, 'star_index')
            def blacklistBed = new File(dir, 'blacklist.bed')

            // Required entries
            def ref = [
                fasta: "${base}/genome.fa",
                gtf  : "${base}/genes.gtf"
            ]
            // Optional entries
            if (bwaDir.isDirectory())     ref['bwa']        = bwaDir.absolutePath
            if (bowtie2Dir.isDirectory()) ref['bowtie2']    = bowtie2Dir.absolutePath
            if (chromapDir.isDirectory()) ref['chromap']    = chromapDir.absolutePath
            if (starDir.isDirectory())    ref['star']       = starDir.absolutePath
            if (blacklistBed.isFile())    ref['blacklist']  = blacklistBed.absolutePath

            def meta = metaFile.isFile() ? new groovy.json.JsonSlurper().parse(metaFile) : [:]
            if (meta.mito_name != null)  ref['mito_name']  = meta.mito_name
            if (meta.macs_gsize != null) ref['macs_gsize'] = meta.macs_gsize

            return [(name): ref]
        }
}.call()
