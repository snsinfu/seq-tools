includeConfig 'genome_catalog.config'
includeConfig 'macs3_chip_histone.config'

params {
    save_macs_pileup = true
}

profiles {
    se_broad {
        params {
            narrow_peak    = false
            broad_cutoff   = 0.10
            fragment_size  = 200
            macs_minlength = 400
            macs_maxgap    = 50  // 4x = 200bp for broad peaks
        }
    }

    cheap {
        params {
            skip_picard_metrics   = true
            skip_preseq           = true
            skip_plot_profile     = true
            skip_plot_fingerprint = true
            skip_spp              = true
            skip_consensus_peaks  = true
            skip_deseq2_qc        = true
            skip_igv              = true
        }
    }
}
